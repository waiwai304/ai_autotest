COMPOSE_PROJECT_NAME=web-test-platform
TZ=Asia/Shanghai

PLATFORM_PORT=3008

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=***
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3008

POSTGRES_DB=web_test_platform
POSTGRES_USER=web_test_platform
POSTGRES_PASSWORD=***
DATABASE_URL=postgresql://web_test_platform:***@postgres:5432/web_test_platform

REDIS_PASSWORD=***
CELERY_BROKER_URL=redis://:***@redis:6379/0
CELERY_RESULT_BACKEND=redis://:***@redis:6379/1

# 产物/报告/Manifest 统一存 web-blackbox（ian 2026-09-23 指定）
ARTIFACT_ROOT=/data/artifacts
REPORT_ROOT=/data/reports
MANIFEST_ROOT=/data/run-manifests
ARTIFACT_RETENTION_DAYS=30

BROWSER_WORKER_CONCURRENCY=1
DEFAULT_SITE_CONCURRENCY=2

AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=90

ALLOW_MUTATING_TESTS=false

# Runner（挂载到容器 /workspace/runner 的现有 Playwright 项目）
RUNNER_ROOT=/workspace/runner
RUNNER_NPM_CMD=npx
