{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["run_id", "job_id", "site", "scenario", "dataset", "runtime", "steps"],
  "properties": {
    "run_id": { "type": "string", "maxLength": 100 },
    "job_id": { "type": "string", "maxLength": 100 },
    "site": {
      "type": "object",
      "required": ["id", "base_url", "adapter", "allowed_host"],
      "properties": {
        "id": { "type": "string" },
        "base_url": { "type": "string" },
        "adapter": { "type": "string" },
        "allowed_host": { "type": "string" }
      }
    },
    "scenario": { "type": "object" },
    "dataset": { "type": "object" },
    "runtime": {
      "type": "object",
      "required": ["browser", "device", "locale"],
      "properties": {
        "browser": { "enum": ["chromium", "firefox", "webkit"] },
        "device": { "type": "string" },
        "locale": { "type": "string" }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": { "type": "string" },
          "params": { "type": "object" },
          "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 }
        }
      }
    }
  }
}
